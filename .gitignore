# =========================================================
# Git Ignore — Academic IR System
# =========================================================

# Python Virtual Environments
venv/
env/
academic-ir/venv/
.venv/

# Environment Variables & Secrets
.env
.env.*
academic-ir/.env
academic-ir/.env.*
!academic-ir/.env.example
academic-ir/academic-ir-frontend/.env.local
academic-ir/academic-ir-frontend/.env.*.local
!academic-ir/academic-ir-frontend/.env.example

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Frontend Build & Dependencies
node_modules/
academic-ir/academic-ir-frontend/node_modules/
.next/
academic-ir/academic-ir-frontend/.next/
out/
dist/

# Large Document Data (PDF files & raw crawlers ~277MB)
*.pdf
*.PDF
academic-ir/data/raw/
academic-ir/data/extracted/
dataset_ocw_ui/
data/raw/
data/extracted/

# SQLite WAL & temporary files (keep main academic_ir.db)
*.db-wal
*.db-shm

# Logs & OS artifacts
*.log
scraper.log
.DS_Store
Thumbs.db
